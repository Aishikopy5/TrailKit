# ==========================================
# TrailKit Environment Configuration
# NEVER commit the real .env file to git!
# ==========================================

# Application Environment
ENVIRONMENT=development
DEBUG=false
HOST=0.0.0.0
PORT=8000
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Open-Weight LLM & Planner (Gemma / Tinker)
GEMMA_API_BASE=http://localhost:11434/v1
GEMMA_MODEL_NAME=gemma2:9b
TINKER_MODEL_ENDPOINT=
TINKER_API_KEY=

# Search & Grounding (SerpApi)
SERPAPI_API_KEY=

# Voice Briefing (ElevenLabs - processed in-memory, no audio stored)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# WhatsApp Bot Integration
WHATSAPP_WEBHOOK_SECRET=replace_with_strong_random_secret_min_32_chars
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=

# Database / Storage (Optional - In-Memory Fallback Active by Default)
MONGODB_URI=
POSTGRES_URI=

# Monitoring & Error Reporting (PII & Health data scrubbed)
SENTRY_DSN=

# Security & Rate Limiting
RATE_LIMIT_PER_MINUTE=20
SESSION_SECRET_KEY=change_this_to_a_secure_random_string_in_production
